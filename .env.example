# vLLM 서버 접속 정보
LLM_API_ENDPOINT=http://vllm-host:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct

# 다중 모델 실험용. LLM_MODEL1/2/3 중 하나라도 설정돼 있으면
# run_robustness_test.py가 그것들만 순서대로 쓰고, 하나도 없으면
# 위 LLM_MODEL 하나만 쓴다.
# LLM_MODEL1=Qwen/Qwen2.5-32B-Instruct
# LLM_MODEL2=Qwen/Qwen2.5-72B-Instruct
# LLM_MODEL3=

# structured output 강제 방식.
# 반드시 `python bench/check_endpoint.py`로 확인할 것 —
# 틀려도 에러가 나지 않고 조용히 무시되어 스키마 강제 없이 돈다.
#   guided_json  : vLLM 구형
#   json_schema  : vLLM 신형 / OpenAI
#   prompt       : 강제 없음. 프롬프트로 요청 + 파싱 재시도
LLM_STRUCTURED_MODE=guided_json
LLM_GUIDED_BACKEND=xgrammar

# 호출 제어. RPM은 Gateway 한도에 맞춘다.
# 동시성은 Little's Law로: 필요 동시 호출 ≈ (RPM/60) x 평균 응답 지연.
# RPM=360, 지연 2초면 12. 배치 크기(AGENT_MAX_BATCH)는 그 안에서 움직여야 한다.
LLM_REQUESTS_PER_MINUTE=360
LLM_MAX_CONCURRENCY=12
LLM_MAX_HTTP_RETRIES=3

# 에이전트 예산
AGENT_MAX_BATCH=8
AGENT_MAX_LLM_CALLS=300

# robustness 배치 반복 횟수 (run_robustness_test.py --reps 기본값)
ROBUSTNESS_REPS=3

# k8s 사용 시
K8S_NAMESPACE=
