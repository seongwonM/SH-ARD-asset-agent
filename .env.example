# vLLM 서버 접속 정보 (OpenAI 호환 엔드포인트)
# k8s에서는 secret `sh-ard-asset-agent-secret`이 envFrom으로 주입하므로
# 이 파일은 로컬 실행에서만 쓰인다. 파서는 자체 구현이라 python-dotenv가 필요 없다.
LLM_API_ENDPOINT=http://vllm-host:8000/v1
LLM_API_KEY=EMPTY
# 쉼표로 여러 개를 적으면 배치가 모델마다 한 바퀴씩 돌고, 결과 폴더가
# <타임스탬프>_<모델명>으로 갈린다 (예: Qwen/Qwen2.5-32B-Instruct,meta-llama/Llama-3.1-70B).
# 하나만 적으면 한 번 돈다. CSV 한 개를 처리하는 run.py는 항상 첫 번째만 쓴다.
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct

# 호출 제어. 둘 중 **작은 쪽이 실제 상한**이 된다.
# 호출 하나가 15초쯤 걸리므로 동시성 6이면 분당 24회 - RPM 120에 닿기 전에
# 동시성이 먼저 묶는다. LLM API에 실제로 가해지는 압력은 동시성이 정하므로,
# 올릴 때는 그쪽부터 보고 RPM은 게이트웨이 한도로만 쓸 것.
# (k8s 배치는 이 값을 secret이 아니라 k8s/column-poc-job.yaml의 env에서 받는다 -
#  실험 설정이라 결과와 같은 커밋에 남아야 한다. 여기 값은 로컬 실행용이다.)
LLM_REQUESTS_PER_MINUTE=120
LLM_MAX_CONCURRENCY=6

# 호출 하나가 얼마나 버티는가. 지우면 코드 기본값(600 / 1 / 5 / 2)으로 돈다.
# 아래는 오래 돌려두는 배치 기준이다 - 엔드포인트가 잠깐 흔들렸다고 CSV 하나가
# 통째로 실패하면 그 실행은 다시 돌려야 하고, 밤새 도는 배치에서는 기다리는
# 쪽이 항상 싸다. (k8s 배치는 job yaml의 env에서 같은 값을 받는다.)
LLM_TIMEOUT_SECONDS=1800
# 이 어댑터의 재시도. JSON 파싱 실패까지 포함해 "무슨 실패든" 다시 던진다.
# 총 시도 = 이 값 + 1.
LLM_MAX_RETRIES=4
# 재시도 사이 대기(지수): 20 -> 40 -> 80 -> 160초. 0이면 즉시 다시 던진다.
LLM_RETRY_BACKOFF_SECONDS=20
# openai SDK가 연결 오류/429/5xx에 자체적으로 무는 재시도(위 재시도의 안쪽 층).
LLM_HTTP_RETRIES=4

# k8s 사용 시. 이 파일의 LLM_* 값을 secret으로 올리는 것은
# ./k8s/scripts/create-secret-from-env.ps1 이다(화이트리스트 방식).
K8S_NAMESPACE=
